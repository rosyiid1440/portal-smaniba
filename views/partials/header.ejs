<nav x-data="{ open: false }" class="bg-gray-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <div class="flex items-center">
                <div class="flex-shrink-0 text-white font-bold text-lg">
                    <i class="fa-solid fa-shield-halved"></i>
                    Portal SMANIBA
                </div>
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <a href="/portal"
                            class="text-gray-300 hover:bg-gray-700 hover:text-white rounded-md px-3 py-2 text-sm font-medium">Portal</a>
                        <% if (isAdmin) { %>
                            <a href="/admin"
                                class="text-gray-300 hover:bg-gray-700 hover:text-white rounded-md px-3 py-2 text-sm font-medium">Admin</a>
                            <% } %>
                    </div>
                </div>
            </div>
            <div class="hidden md:block">
                <div class="ml-4 flex items-center md:ml-6">
                    <span class="text-gray-400 mr-4">Halo, <%= userName %></span>
                    <a href="/logout"
                        class="bg-red-600 text-white hover:bg-red-700 rounded-md px-3 py-2 text-sm font-medium">
                        <i class="fa-solid fa-right-from-bracket mr-1"></i>Keluar
                    </a>
                </div>
            </div>
            <!-- Tombol Hamburger untuk Mobile -->
            <div class="-mr-2 flex md:hidden">
                <button @click="open = !open" type="button"
                    class="inline-flex items-center justify-center rounded-md bg-gray-800 p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800"
                    aria-controls="mobile-menu" aria-expanded="false">
                    <span class="sr-only">Buka menu utama</span>
                    <svg :class="{'hidden': open, 'block': !open }" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                        stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <svg :class="{'block': open, 'hidden': !open }" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                        stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Menu Mobile -->
    <div x-show="open" class="md:hidden" id="mobile-menu">
        <div class="space-y-1 px-2 pt-2 pb-3 sm:px-3">
            <a href="/portal"
                class="text-gray-300 hover:bg-gray-700 hover:text-white block rounded-md px-3 py-2 text-base font-medium">Portal</a>
            <% if (isAdmin) { %>
                <a href="/admin"
                    class="text-gray-300 hover:bg-gray-700 hover:text-white block rounded-md px-3 py-2 text-base font-medium">Admin</a>
                <% } %>
        </div>
        <div class="border-t border-gray-700 pt-4 pb-3">
            <div class="flex items-center px-5">
                <div class="flex-shrink-0">
                    <i class="fa-solid fa-user-circle fa-2x text-gray-400"></i>
                </div>
                <div class="ml-3">
                    <div class="text-base font-medium leading-none text-white">
                        <%= userName %>
                    </div>
                </div>
            </div>
            <div class="mt-3 space-y-1 px-2">
                <a href="/logout"
                    class="block rounded-md px-3 py-2 text-base font-medium text-gray-400 hover:bg-gray-700 hover:text-white">Keluar</a>
            </div>
        </div>
    </div>
    <!-- Script untuk AlpineJS -->
    <script src="//unpkg.com/alpinejs" defer></script>
</nav>