<!DOCTYPE html>
<html lang="id" class="h-full bg-gray-100">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Aplikasi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">
</head>

<body class="h-full">
    <div class="min-h-full">
        <%- include('partials/header', { userName, isAdmin }) %>

            <header class="bg-white shadow-sm">
                <div class="mx-auto max-w-7xl py-6 px-4 sm:px-6 lg:px-8">
                    <!-- Header yang lebih ramah -->
                    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Selamat Datang, <%= userName %>!</h1>
                    <p class="mt-1 text-gray-500">Pilih aplikasi yang ingin Anda akses di bawah ini.</p>
                </div>
            </header>
            <main>
                <div class="mx-auto max-w-7xl py-6 px-4 sm:px-6 lg:px-8">
                    <% if (apps.length> 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                            <% apps.forEach(app=> { %>
                                <!-- Kartu yang Didesain Ulang -->
                                <a href="<%= app.url %>" target="_blank"
                                    class="group relative block transform overflow-hidden rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                                    <div class="flex items-center">
                                        <!-- Ikon dengan latar belakang gradien -->
                                        <div
                                            class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 text-white">
                                            <i class="fa-solid <%= app.icon %> fa-2x"></i>
                                        </div>
                                        <div class="ml-4">
                                            <!-- Tipografi profesional -->
                                            <h3 class="text-lg font-semibold text-gray-900">
                                                <%= app.name %>
                                            </h3>
                                            <p class="mt-1 text-sm text-gray-500">Buka Aplikasi</p>
                                        </div>
                                    </div>
                                    <!-- Ikon panah untuk keterjangkauan -->
                                    <span
                                        class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-300 transition-all duration-300 group-hover:pr-3 group-hover:text-blue-600">
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </span>
                                </a>
                                <% }); %>
                        </div>
                        <% } else { %>
                            <!-- Pesan "empty state" yang lebih baik -->
                            <div class="text-center rounded-lg border-2 border-dashed border-gray-300 p-12">
                                <i class="fa-solid fa-box-open fa-3x mx-auto text-gray-400"></i>
                                <h3 class="mt-4 text-lg font-medium text-gray-900">Tidak Ada Aplikasi</h3>
                                <p class="mt-1 text-sm text-gray-500">Tidak ada aplikasi yang tersedia untuk Anda saat
                                    ini. Hubungi admin jika Anda merasa ini adalah kesalahan.</p>
                            </div>
                            <% } %>
                </div>
            </main>
    </div>
</body>

</html>